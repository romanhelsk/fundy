# ---------- Database ----------
# Local default: a SQLite file. In production, your Turso database:
#   TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create <db-name>`>
DATABASE_URL=file:data/fundy.db

# ---------- App ----------
API_PORT=3001
# Origins allowed to make changes (comma-separated). Vercel URLs are added automatically.
APP_ORIGIN=http://localhost:5173,http://localhost:3001
# Defaults to true in production (NODE_ENV=production).
# SECURE_COOKIES=true

# ---------- Accounts ----------
# Test accounts from server/seed.ts. Default: on locally, off in production.
# SEED_DEMO_USER=false
# First admin in production (created only if no admin exists; must change password at first sign-in).
# BOOTSTRAP_ADMIN_EMAIL=you@yourcompany.com
# BOOTSTRAP_ADMIN_PASSWORD=<a long temporary password>
# BOOTSTRAP_ADMIN_NAME=Admin

# ---------- Email (sign-in codes) ----------
# Without these, codes are printed to the server console (development only;
# production refuses to fall back to the console).
# RESEND_API_KEY=re_...
# MAIL_FROM=Funds <no-reply@yourdomain.com>

# ---------- Scheduled jobs ----------
# Protects GET /api/cron/enforce-deadlines (expires overdue pending transactions).
# CRON_SECRET=<long random string>

# ---------- Payments ----------
PAYMENT_GATEWAY=test
TEST_GATEWAY_LATENCY_MS=1800
